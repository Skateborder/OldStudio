{
  "manifest_version": 3,
  "name": "OldStudio - OG YouTube Studio Analytics",
  "version": "1.0.0",
  "description": "Restore YouTube Studio's classic channel Analytics view instead of channel Insights.",
  "content_scripts": [
    {
      "matches": ["https://studio.youtube.com/*"],
      "js": ["flags.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://studio.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
